# PostgreSQL connection string used by the backend.
# Copy this file to .env and set your local database credentials.
# .env is git-ignored, so real credentials stay out of version control.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/salary_workspace

# Separate, disposable database for integration tests. Must NOT be the app
# database above — the tests delete data between runs.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/salary_workspace_test
