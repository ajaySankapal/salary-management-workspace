# PostgreSQL connection string used by the backend.
# Copy this file to .env and set your local database credentials.
# .env is git-ignored, so real credentials stay out of version control.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/salary_workspace

# Port the API/server listens on (defaults to 4000).
PORT=4000

# Set to "production" when deploying. In production the server stores sessions in
# PostgreSQL, serves the built frontend, marks the session cookie "secure" (HTTPS),
# and trusts one proxy hop.
NODE_ENV=development

# The session cookie is "secure" (HTTPS-only) in production. Set this to false to
# try the production build locally over plain http://localhost (otherwise the
# browser won't send the cookie and API calls return 401). Leave unset in a real
# HTTPS deploy.
# COOKIE_SECURE=false

# Separate, disposable database for integration tests. Must NOT be the app
# database above — the tests delete data between runs.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/salary_workspace_test

# Secret used to sign the login session cookie. Use a long, random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Pre-created HR demo account, seeded into the database by `npm run seed`.
DEMO_HR_USERNAME=hr@salary.demo
DEMO_HR_PASSWORD=salary-demo-123
